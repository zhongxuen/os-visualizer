# OS Visualizer -- environment variables
#
# Nothing here is required to run the app. There is no database and no secret: every
# module is a deterministic client-side simulation.
#
# Copy to .env.local for local development. Never commit .env.local.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# Canonical origin, used for metadataBase (src/lib/site.ts). Optional. Unset, the app
# falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then
# http://localhost:3000. Set it once the project has a custom domain.
#
# NEXT_PUBLIC_SITE_URL="https://os-visualizer.vercel.app"

# Provided by Vercel; do not set these yourself:
#   VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL, VERCEL_ENV
